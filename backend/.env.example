# Production Environment Configuration
# Copy this file to .env and configure all required secrets.

# MySQL 8.0 Connection String
DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<db_host>:3306/<db_name>?charset=utf8mb4

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local or S3 Storage Backend ("local" or "s3")
STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://lms-fullstack-platform.netlify.app,http://localhost:5173

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@lms-institute.edu
FRONTEND_URL=https://lms-fullstack-platform.netlify.app
