PROJECT_NAME="LMS Application"
VERSION="1.1.0"
API_V1_STR="/api"

# Database Configuration
# Primary: Local MySQL 8.0 Server
DATABASE_URL="mysql+pymysql://root:root@localhost:3306/lms_db?charset=utf8mb4"
TEST_DATABASE_URL="mysql+pymysql://root:root@localhost:3306/lms_test_db?charset=utf8mb4"

# JWT Secret & Auth
JWT_SECRET="REDACTED_LEGACY_JWT_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
