# Production Environment Configuration
# Copy this file to .env and configure all required secrets.

# MySQL 8.0 Connection String
DATABASE_URL=mysql+pymysql://lms_user:lms_password@localhost:3306/lms_db?charset=utf8mb4

# Rotated cryptographically secure 256-bit JWT secret (REQUIRED: must not match legacy git history key)
JWT_SECRET=f9a8c1d3e5b7a9f0c2d4e6b8a0c2e4f6a8b0c2e4f6a8c1d3e5b7a9f0c2d4e6b8
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local or S3 Storage Backend ("local" or "s3")
STORAGE_BACKEND=local
S3_BUCKET=lms-storage-production
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,https://lms-fullstack-vibe.netlify.app

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@lms-institute.edu
FRONTEND_URL=https://lms-fullstack-vibe.netlify.app
